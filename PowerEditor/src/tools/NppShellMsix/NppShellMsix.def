;
; Exports the two functions the packaged COM surrogate (dllhost.exe) looks for.
; They are aliased to NppDll* because combaseapi.h declares the canonical names with
; DECLSPEC_IMPORT, which makes a direct definition fail with C2375.

LIBRARY NppShellMsix

EXPORTS
    DllGetClassObject=NppDllGetClassObject PRIVATE
    DllCanUnloadNow=NppDllCanUnloadNow PRIVATE
